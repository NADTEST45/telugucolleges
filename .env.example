# TeluguColleges env vars — copy to .env.local for dev, configure in Vercel dashboard for prod

# ── Site URL (only needed if hosting off telugucolleges.com) ──
# NEXT_PUBLIC_SITE_URL=https://telugucolleges.com

# ── Google Search Console verification (overrides hardcoded token in layout.tsx) ──
# GOOGLE_SITE_VERIFICATION=

# ── Supabase (required for admin, college-admin, edits, shortlist, auth) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Upstash Redis (required for cluster-wide rate limiting in production) ──
# If unset, middleware falls back to an in-memory limiter that is per-instance
# and ineffective across Vercel's serverless fleet. Create a free DB at
# https://console.upstash.com and paste the REST creds here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
